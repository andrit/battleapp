# Root env for the Docker Compose game stack. Copy to `.env` (gitignored) and fill in.
# Docker Compose auto-loads a `.env` in this directory for ${VAR} interpolation in compose.yml.

# Google OAuth **Web** client id — the id_token `aud` the server verifies (server/src/auth/oidc.ts).
# From Google Cloud → APIs & Services → Credentials → your "battleapp — Web" client.
GOOGLE_CLIENT_ID=

# Apple Sign-in Services ID (later, from the Apple Developer portal).
APPLE_CLIENT_ID=

# Secret used to sign our access tokens (HS256). Keep it secret; rotate on exposure.
# Generate one: openssl rand -hex 32
AUTH_JWT_SECRET=
