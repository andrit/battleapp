# Game-server base URL for the app.
# Simulator/emulator on the same machine as the server: http://localhost:4000
# Physical device via Expo Go: use the dev machine's LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google Sign-In (OAuth/OIDC) — client IDs are PUBLIC (they ship in the app). Requires a dev build;
# unset → the "Continue with Google" button shows "coming soon" and Expo Go still runs (dev accounts).
#   WEB client id: required to receive an id_token, and it's the token's `aud` — it MUST equal the
#   server's GOOGLE_CLIENT_ID (root .env). This is the one value shared between app and server.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
#   iOS client id (same client whose reversed id is app.json's iosUrlScheme):
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=yyyyy.apps.googleusercontent.com

# Analytics (PostHog) — OPTIONAL. Leave unset to disable: with no key the analytics wrapper is a
# pure no-op (loads no SDK, makes no network calls). Set both to enable event capture.
# EXPO_PUBLIC_POSTHOG_KEY=phc_xxx
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
